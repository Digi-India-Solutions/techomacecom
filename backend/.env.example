# # development | production  (decides which URL list CORS allows)
# NODE_ENV=development
# PORT=5001

# # Allowed frontend origins (CORS) — comma-separated, no trailing slash
# LOCAL_URL=http://localhost:3000,http://127.0.0.1:3000
# PRODUCTION_URL=https://yourdomain.com,https://admin.yourdomain.com
# FRONTEND_URL=http://localhost:3000

# # JWT
# ACCESS_TOKEN_EXPIRY=1d
# REFRESH_TOKEN_EXPIRY=7d
# ACCESS_TOKEN_COOKIE=900000
# REFRESH_TOKEN_COOKIE=604800000
# JWT_SECRET_KEY=change_me_long_random_string
# REFRESH_TOKEN_SECRET=change_me_another_long_random_string

# # Email
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# # PostgreSQL (individual values — no connection URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_db_name
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SCHEMA=public
# DB_SSL=false
# DB_POOL_MAX=10
