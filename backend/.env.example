# # ONE .env for local and production (config/load-env.js). Any key can have two versions:
# #   KEY_LOCAL=…       → npm run dev, db:migrate, db:seed, admin:set-password
# #   KEY_PRODUCTION=…  → npm start, db:deploy, db:seed:prod, admin:set-password:prod
# # Keys without a suffix are shared by both. NODE_ENV comes from the npm scripts.
# PORT=5001

# # URLs for BOTH environments — keep them all in this one file and never edit them on deploy.
# # development uses *_LOCAL (defaults below), production uses *_PRODUCTION (required).
# # CORS automatically allows the storefront + admin URLs (and www. / 127.0.0.1 twins).
# FRONTEND_URL_LOCAL=http://localhost:3000
# ADMIN_URL_LOCAL=http://localhost:3001            # staff invite / reset-password links
# API_URL_LOCAL=http://localhost:5001              # public origin of this API → image URLs
# FRONTEND_URL_PRODUCTION=https://buydenmed.com
# ADMIN_URL_PRODUCTION=https://admin.buydenmed.com
# API_URL_PRODUCTION=https://api.buydenmed.com
# # Optional extra CORS origins, comma-separated (e.g. a staging domain)
# LOCAL_URL=
# PRODUCTION_URL=

# # JWT  (access token = short-lived, refresh token = rotated on every use)
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=30d
# ACCESS_TOKEN_COOKIE=900000                 # access cookie lifetime in ms (match ACCESS_TOKEN_EXPIRY)
# REFRESH_TOKEN_COOKIE=2592000000            # refresh cookie lifetime in ms (match REFRESH_TOKEN_EXPIRY)
# JWT_SECRET_KEY_LOCAL=change_me_long_random_string            # ≥ 32 chars in production
# JWT_SECRET_KEY_PRODUCTION=   # 32+ random chars, different from the refresh secret
# REFRESH_TOKEN_SECRET_LOCAL=change_me_another_long_random_string  # different from JWT_SECRET_KEY
# REFRESH_TOKEN_SECRET_PRODUCTION=   # 32+ random chars
# DATA_ENCRYPTION_KEY=                       # 32+ random chars; encrypts refund bank details. Set once, never change.
# COOKIE_DOMAIN=                             # e.g. .buydenmed.com in production (shared by api / www / admin)
# COOKIE_SECURE=                             # defaults to true in production

# # Email (Gmail app password) — staff invites and password resets
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# # PostgreSQL (individual values — no connection URL)
# DB_HOST_LOCAL=localhost
# DB_HOST_PRODUCTION=localhost
# DB_PORT_LOCAL=5432
# DB_PORT_PRODUCTION=5432
# DB_NAME_LOCAL=your_db_name
# DB_NAME_PRODUCTION=buydenmed
# DB_USER_LOCAL=postgres
# DB_USER_PRODUCTION=buydenmed_app
# DB_PASSWORD_LOCAL=your_password
# DB_PASSWORD_PRODUCTION=   # the VPS database password
# DB_SCHEMA=public
# DB_SSL_LOCAL=false
# DB_SSL_PRODUCTION=false
# DB_POOL_MAX=10

# # First Super Admin (created by `npm run db:seed` if missing)
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_EMAIL=you@yourcompany.com
# SUPER_ADMIN_PASSWORD=                      # empty → random temporary password printed once

# # Customer OTP login
# SMS_PROVIDER_LOCAL=console                       # console (dev: OTP printed in terminal) | msg91
# SMS_PROVIDER_PRODUCTION=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=                     # DLT-approved OTP template
# OTP_EXPIRY_MINUTES=5
# OTP_DEV_ECHO=                              # defaults to true outside production: OTP returned in the API response

# # Continue with Google — OAuth 2.0 "Web application" Client ID
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# # Storefront customers — email + password sign-in (mobile OTP sign-in is disabled;
# # the SMS OTP settings above are still used to verify / change a mobile number)
# EMAIL_OTP_EXPIRY_MINUTES=10                # sign-up email verification code
# CUSTOMER_LOCK_MINUTES=15                   # account locked after 5 wrong passwords
# CUSTOMER_RESET_EXPIRY_MINUTES=30           # "forgot password" link lifetime
# CUSTOMER_RESET_COOLDOWN_SECONDS=60         # minimum gap between two reset emails per account
# CUSTOMER_AUTH_RATE_LIMIT=20                # sign-up / sign-in requests per IP per 10 min
# CUSTOMER_RESET_RATE_LIMIT=5                # forgot-password requests per IP per 15 min

# # Image uploads — stored on this server's disk, converted to WebP
# UPLOADS_DIR=uploads                        # relative to backend/ (or an absolute path)
# ASSET_BASE_URL=                           # only if /uploads is served from a CDN; defaults to API_URL_*
# UPLOAD_MAX_FILE_MB=10
# IMAGE_WEBP_QUALITY=85                      # lossy quality, visually identical at 80–90
# IMAGE_WEBP_LOSSLESS=false                  # true = pixel-perfect but 3–5× larger files
# IMAGE_WEBP_EFFORT=5                        # 0 fast … 6 smallest
# IMAGE_MAX_DIMENSION=2560                   # longest side of the stored image
# IMAGE_VARIANT_WIDTHS=320,640,1024,1600     # extra sizes for srcset
