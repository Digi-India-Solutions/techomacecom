{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon --ignore prisma/ server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "cross-env NODE_ENV=development prisma migrate dev",
    "db:deploy": "cross-env NODE_ENV=production prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:status:prod": "cross-env NODE_ENV=production prisma migrate status",
    "db:studio": "prisma studio",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "node server.js",
    "db:seed": "node prisma/seed.js",
    "db:seed:prod": "cross-env NODE_ENV=production node prisma/seed.js",
    "db:seed:inventory": "node scripts/seed-inventory.js",
    "admin:set-password": "node scripts/set-admin-password.js",
    "admin:set-password:prod": "cross-env NODE_ENV=production node scripts/set-admin-password.js",
    "test:catalog": "node --test --test-concurrency=1 tests/integration/catalog.e2e.js",
    "test:auth": "node --test --test-concurrency=1 tests/integration/customer-auth.e2e.js",
    "test:enquiries": "node --test --test-concurrency=1 tests/integration/enquiries.e2e.js",
    "test:reviews": "node --test --test-concurrency=1 tests/integration/reviews.e2e.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "sanitize-html": "2.17.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
